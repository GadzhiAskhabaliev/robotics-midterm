' Builds the servo parallel gripper from the course drawings and opens the jaws.
' Units in the API are metres.

Dim swApp As Object

Sub main()
    Dim linkPath As String
    Dim fingerPath As String
    Dim crankPath As String
    Dim toothPath As String
    Dim holderPath As String
    Dim pinPath As String
    Dim servoPath As String
    Dim assy As Object
    Dim note As String

    On Error Resume Next
    Set swApp = Application.SldWorks
    swApp.Visible = True
    note = ""

    linkPath = SavePart(BuildLink(), "Link")
    fingerPath = SavePart(BuildFinger(), "Finger")
    crankPath = SavePart(BuildCrank(), "CrankGear")
    toothPath = SavePart(BuildTooth(), "ToothGear")
    holderPath = SavePart(BuildHolder(), "Holder")
    pinPath = SavePart(BuildPin(), "Pin")
    servoPath = SavePart(BuildServo(), "Servo")

    Set assy = BuildAssembly(holderPath, fingerPath, linkPath, crankPath, toothPath, pinPath, servoPath)
    If Not assy Is Nothing Then
        assy.ShowNamedView2 "*Isometric", 7
        assy.ViewZoomtofit2
        assy.GraphicsRedraw2
        Animate assy
        note = "Gripper assembly is open. Jaws moved from open to closed."
    Else
        note = "Parts were saved, assembly was not created."
    End If
    swApp.SendMsgToUser2 note, 0, 2
End Sub

Function Folder() As String
    Dim fso As Object
    Dim candidates(2) As String
    Dim i As Integer
    Set fso = CreateObject("Scripting.FileSystemObject")
    candidates(0) = "C:\Temp\Gripper"
    candidates(1) = "C:\Users\Public\Gripper"
    candidates(2) = "D:\Gripper"
    For i = 0 To 2
        On Error Resume Next
        If Not fso.FolderExists(candidates(i)) Then fso.CreateFolder candidates(i)
        If fso.FolderExists(candidates(i)) Then
            Folder = candidates(i)
            Exit Function
        End If
    Next
    Folder = "C:\Temp\Gripper"
End Function

Function SavePart(part As Object, name As String) As String
    Dim path As String
    path = Folder() & "\" & name & ".SLDPRT"
    On Error Resume Next
    part.SaveAs3 path, 0, 1
    part.ShowNamedView2 "*Isometric", 7
    part.ViewZoomtofit2
    SavePart = path
End Function

Function NewPartDoc() As Object
    Dim p As Object
    On Error Resume Next
    Set p = swApp.NewPart
    If p Is Nothing Then
        Set p = swApp.NewDocument("C:\ProgramData\SolidWorks\SOLIDWORKS 2026\templates\Part.prtdot", 0, 0, 0)
    End If
    If p Is Nothing Then
        Set p = swApp.NewDocument("C:\ProgramData\SOLIDWORKS\SOLIDWORKS 2026\templates\Part.prtdot", 0, 0, 0)
    End If
    Set NewPartDoc = p
End Function

Sub ExtrudeCircle(part As Object, x As Double, y As Double, r As Double, depth As Double)
    part.ClearSelection2 True
    part.Extension.SelectByID2 "Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0
    part.SketchManager.InsertSketch True
    part.SketchManager.CreateCircle x, y, 0, x + r, y, 0
    part.ClearSelection2 True
    part.SketchManager.InsertSketch True
    part.FeatureManager.FeatureExtrusion2 True, False, False, 0, 0, depth, 0.01, False, False, False, False, 0, 0, False, False, False, False, True, True, True, 0, 0, False
End Sub

Sub ExtrudeRect(part As Object, x1 As Double, y1 As Double, x2 As Double, y2 As Double, depth As Double)
    part.ClearSelection2 True
    part.Extension.SelectByID2 "Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0
    part.SketchManager.InsertSketch True
    part.SketchManager.CreateCornerRectangle x1, y1, 0, x2, y2, 0
    part.ClearSelection2 True
    part.SketchManager.InsertSketch True
    part.FeatureManager.FeatureExtrusion2 True, False, False, 0, 0, depth, 0.01, False, False, False, False, 0, 0, False, False, False, False, True, True, True, 0, 0, False
End Sub

Sub ExtrudePoly(part As Object, xs As Variant, ys As Variant, depth As Double)
    Dim i As Integer
    Dim n As Integer
    part.ClearSelection2 True
    part.Extension.SelectByID2 "Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0
    part.SketchManager.InsertSketch True
    n = UBound(xs)
    For i = 0 To n - 1
        part.SketchManager.CreateLine xs(i), ys(i), 0, xs(i + 1), ys(i + 1), 0
    Next
    part.SketchManager.CreateLine xs(n), ys(n), 0, xs(0), ys(0), 0
    part.ClearSelection2 True
    part.SketchManager.InsertSketch True
    part.FeatureManager.FeatureExtrusion2 True, False, False, 0, 0, depth, 0.01, False, False, False, False, 0, 0, False, False, False, False, True, True, True, 0, 0, False
End Sub

Sub CutCircle(part As Object, x As Double, y As Double, r As Double)
    part.ClearSelection2 True
    part.Extension.SelectByID2 "Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0
    part.SketchManager.InsertSketch True
    part.SketchManager.CreateCircle x, y, 0, x + r, y, 0
    part.ClearSelection2 True
    part.SketchManager.InsertSketch True
    part.FeatureManager.FeatureCut4 True, False, False, 1, 0, 0.02, 0.02, False, False, False, False, 0, 0, False, False, False, False, False, True, True, True, True, False, 0, 0, False, False
End Sub

Sub AddTeeth(part As Object, n As Integer, rRoot As Double, rTip As Double, depth As Double)
    Dim i As Integer
    Dim ang As Double
    Dim stepA As Double
    Dim half As Double
    Dim xs(3) As Double
    Dim ys(3) As Double
    stepA = 6.28318530717959 / n
    half = stepA * 0.22
    For i = 0 To n - 1
        ang = i * stepA
        xs(0) = rRoot * Cos(ang - half)
        ys(0) = rRoot * Sin(ang - half)
        xs(1) = rTip * Cos(ang - half * 0.45)
        ys(1) = rTip * Sin(ang - half * 0.45)
        xs(2) = rTip * Cos(ang + half * 0.45)
        ys(2) = rTip * Sin(ang + half * 0.45)
        xs(3) = rRoot * Cos(ang + half)
        ys(3) = rRoot * Sin(ang + half)
        ExtrudePoly part, xs, ys, depth
    Next
End Sub

Function BuildLink() As Object
    Dim part As Object
    Dim depth As Double
    depth = 0.003
    Set part = NewPartDoc()
    ' Bosses are 7 mm across, holes 3 mm, centres 31 mm apart, bar 3 mm wide.
    ExtrudeCircle part, 0, 0, 0.0035, depth
    ExtrudeCircle part, 0.031, 0, 0.0035, depth
    ExtrudeRect part, 0, -0.0015, 0.031, 0.0015, depth
    CutCircle part, 0, 0, 0.0015
    CutCircle part, 0.031, 0, 0.0015
    Set BuildLink = part
End Function

Function BuildFinger() As Object
    Dim part As Object
    Dim depth As Double
    Dim ang As Double
    Dim c As Double
    Dim s As Double
    Dim nx As Double
    Dim ny As Double
    Dim x0 As Double
    Dim y0 As Double
    Dim x1 As Double
    Dim y1 As Double
    Dim xs(3) As Double
    Dim ys(3) As Double
    depth = 0.003
    Set part = NewPartDoc()
    ' Pivot hole at the origin. Base is 10 mm wide, second hole 22 mm away.
    ExtrudeCircle part, 0, 0, 0.005, depth
    ExtrudeRect part, 0, -0.005, 0.022, 0.005, depth
    ExtrudeCircle part, 0.022, 0, 0.005, depth
    ' Arm leaves the base at 25 degrees (the 155 degree interior angle) and is 36 mm long, 5 mm wide.
    ang = 25# * 3.14159265358979 / 180#
    c = Cos(ang)
    s = Sin(ang)
    nx = -s
    ny = c
    x0 = 0.022
    y0 = 0
    x1 = x0 + 0.036 * c
    y1 = y0 + 0.036 * s
    xs(0) = x0 + nx * 0.0025: ys(0) = y0 + ny * 0.0025
    xs(1) = x1 + nx * 0.0025: ys(1) = y1 + ny * 0.0025
    xs(2) = x1 - nx * 0.0025: ys(2) = y1 - ny * 0.0025
    xs(3) = x0 - nx * 0.0025: ys(3) = y0 - ny * 0.0025
    ExtrudePoly part, xs, ys, depth
    ' Jaw pad, 16 mm by 12 mm, turned toward the grip.
    xs(0) = x1: ys(0) = y1
    xs(1) = x1 + 0.016 * c: ys(1) = y1 + 0.016 * s
    xs(2) = x1 + 0.016 * c - nx * 0.012: ys(2) = y1 + 0.016 * s - ny * 0.012
    xs(3) = x1 - nx * 0.012: ys(3) = y1 - ny * 0.012
    ExtrudePoly part, xs, ys, depth
    CutCircle part, 0, 0, 0.0015
    CutCircle part, 0.022, 0, 0.0015
    Set BuildFinger = part
End Function

Function BuildCrank() As Object
    Dim part As Object
    Dim depth As Double
    depth = 0.003
    Set part = NewPartDoc()
    ' Gear blank 24.2 mm, teeth out to 29.3 mm, 24 teeth. Arm is 31 mm to an 8 mm boss with a 3 mm hole.
    ExtrudeCircle part, 0, 0, 0.0121, depth
    AddTeeth part, 24, 0.0121, 0.01465, depth
    ' Arm along +X toward the jaws (Assembly_8).
    ExtrudeRect part, 0, -0.003, 0.031, 0.003, depth
    ExtrudeCircle part, 0.031, 0, 0.004, depth
    CutCircle part, 0, 0, 0.0015
    CutCircle part, 0.031, 0, 0.0015
    Set BuildCrank = part
End Function

Function BuildTooth() As Object
    Dim part As Object
    Dim depth As Double
    depth = 0.003
    Set part = NewPartDoc()
    ' Same blank as the crank; Assembly_8 gives both gears a primary arm.
    ExtrudeCircle part, 0, 0, 0.0121, depth
    AddTeeth part, 24, 0.0121, 0.01465, depth
    ExtrudeRect part, 0, -0.003, 0.031, 0.003, depth
    ExtrudeCircle part, 0.031, 0, 0.004, depth
    CutCircle part, 0, 0, 0.0015
    CutCircle part, 0.031, 0, 0.0015
    Set BuildTooth = part
End Function

Function BuildHolder() As Object
    Dim part As Object
    Dim xs(7) As Double
    Dim ys(7) As Double
    Set part = NewPartDoc()
    ' Plate from Holder_6: 50 mm long, 15 mm above the centre and 10 mm below, three 3 mm holes, end radius 10 mm.
    xs(0) = 0: ys(0) = -0.01
    xs(1) = 0.01: ys(1) = -0.01
    xs(2) = 0.026: ys(2) = 0
    xs(3) = 0.04: ys(3) = 0
    xs(4) = 0.05: ys(4) = 0.01
    xs(5) = 0.04: ys(5) = 0.015
    xs(6) = 0.01: ys(6) = 0.015
    xs(7) = 0: ys(7) = 0.005
    ExtrudePoly part, xs, ys, 0.004
    ExtrudeCircle part, 0.05, 0.01, 0.01, 0.004
    CutCircle part, 0.01, 0.01, 0.0015
    CutCircle part, 0.026, 0.01, 0.0015
    CutCircle part, 0.01, -0.004, 0.0015
    ' Slot, 12 mm long, radius 6 mm.
    ExtrudeCircle part, 0.032, 0.005, 0.006, 0.004
    ' The slot is a cut, so remove it.
    CutCircle part, 0.03, 0.005, 0.006
    CutCircle part, 0.042, 0.005, 0.006
    ExtrudeRect part, 0.03, -0.001, 0.042, 0.011, 0.004
    CutCircle part, 0.03, 0.005, 0.006
    CutCircle part, 0.042, 0.005, 0.006
    Set BuildHolder = part
End Function

Function BuildPin() As Object
    Dim part As Object
    Set part = NewPartDoc()
    part.ClearSelection2 True
    part.Extension.SelectByID2 "Front Plane", "PLANE", 0, 0, 0, False, 0, Nothing, 0
    part.SketchManager.InsertSketch True
    part.SketchManager.CreateCircle 0, 0, 0, 0.00145, 0, 0
    part.ClearSelection2 True
    part.SketchManager.InsertSketch True
    part.FeatureManager.FeatureExtrusion2 True, False, False, 0, 0, 0.012, 0.01, False, False, False, False, 0, 0, False, False, False, False, True, True, True, 0, 0, False
    Set BuildPin = part
End Function

Function BuildServo() As Object
    Dim part As Object
    Set part = NewPartDoc()
    ' Blue servo block under the holder. The drawings do not dimension the servo body.
    ExtrudeRect part, -0.01, -0.006, 0.012, 0.016, 0.02
    part.SetMaterialPropertyName2 "", "", "Blue"
    Set BuildServo = part
End Function

Function BuildAssembly(holderPath As String, fingerPath As String, linkPath As String, crankPath As String, toothPath As String, pinPath As String, servoPath As String) As Object
    Dim assy As Object
    On Error Resume Next
    Set assy = swApp.NewAssembly
    If assy Is Nothing Then
        Set assy = swApp.NewDocument("C:\ProgramData\SolidWorks\SOLIDWORKS 2026\templates\Assembly.asmdot", 0, 0, 0)
    End If
    If assy Is Nothing Then Exit Function

    ' Layout like Assembly_8: both gear arms toward the jaws, two secondary links, two fingers.
    AddAt assy, holderPath, 0, 0, 0, 0, 1
    AddAt assy, servoPath, 0.004, -0.002, -0.02, 0, 1
    AddAt assy, toothPath, 0.01, 0.01, 0.004, 0.4, 1
    AddAt assy, crankPath, 0.026, 0.01, 0.004, -0.4, 1
    AddAt assy, linkPath, 0.01, -0.004, 0.007, 0.3, 1
    AddAt assy, linkPath, 0.039, 0.022, 0.008, 0.4, 1
    AddAt assy, fingerPath, 0.055, -0.002, 0.004, -0.45, 1
    AddAt assy, fingerPath, 0.039, 0.022, 0.008, 0.45, -1
    AddAt assy, pinPath, 0.01, 0.01, 0.002, 0, 1
    AddAt assy, pinPath, 0.026, 0.01, 0.002, 0, 1
    AddAt assy, pinPath, 0.055, -0.002, 0.002, 0, 1
    AddAt assy, pinPath, 0.039, 0.022, 0.002, 0, 1
    assy.EditRebuild3
    Set BuildAssembly = assy
End Function

Sub AddAt(assy As Object, path As String, x As Double, y As Double, z As Double, ang As Double, ySign As Double)
    Dim comp As Object
    Dim math As Object
    Dim data(15) As Double
    Dim c As Double
    Dim s As Double
    On Error Resume Next
    Set comp = assy.AddComponent5(path, 0, "", False, "", x, y, z)
    If comp Is Nothing Then Exit Sub
    c = Cos(ang)
    s = Sin(ang)
    data(0) = c: data(1) = -s * ySign: data(2) = 0
    data(3) = s: data(4) = c * ySign: data(5) = 0
    data(6) = 0: data(7) = 0: data(8) = 1
    data(9) = x: data(10) = y: data(11) = z
    data(12) = 1
    Set math = swApp.GetMathUtility
    comp.Transform2 = math.CreateTransform(data)
End Sub

Sub Animate(assy As Object)
    Dim comps As Variant
    Dim lower As Object
    Dim upper As Object
    Dim i As Integer
    Dim t As Double
    Dim n As Integer
    On Error Resume Next
    comps = assy.GetComponents(False)
    n = UBound(comps)
    ' The two fingers are the 7th and 8th components added (0-based 6 and 7) if nothing failed.
    ' Fall back to any component whose name starts with Finger.
    For i = 0 To n
        If InStr(1, comps(i).Name2, "Finger", 1) > 0 Then
            If lower Is Nothing Then
                Set lower = comps(i)
            ElseIf upper Is Nothing Then
                Set upper = comps(i)
            End If
        End If
    Next
    If lower Is Nothing Or upper Is Nothing Then Exit Sub
    For i = 0 To 12
        t = i / 12#
        PlaceJaw lower, 0.055, -0.012, 0.004, -0.45 + 0.55 * t, 1
        PlaceJaw upper, 0.055, 0.028, 0.008, 0.45 - 0.55 * t, -1
        assy.GraphicsRedraw2
    Next
End Sub

Sub PlaceJaw(comp As Object, x As Double, y As Double, z As Double, ang As Double, ySign As Double)
    Dim math As Object
    Dim data(15) As Double
    Dim c As Double
    Dim s As Double
    On Error Resume Next
    c = Cos(ang)
    s = Sin(ang)
    data(0) = c: data(1) = -s * ySign: data(2) = 0
    data(3) = s: data(4) = c * ySign: data(5) = 0
    data(6) = 0: data(7) = 0: data(8) = 1
    data(9) = x: data(10) = y: data(11) = z
    data(12) = 1
    Set math = swApp.GetMathUtility
    comp.Transform2 = math.CreateTransform((data))
End Sub
