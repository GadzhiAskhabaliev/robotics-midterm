' Live open/close. Prefer driving an Angle mate; else rotate drive gear.
' Open assembly -> Macro Run. ~6 seconds. No Motion Study export — for screen recording.

Option Explicit

#If VBA7 Then
Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal ms As Long)
#Else
Private Declare Sub Sleep Lib "kernel32" (ByVal ms As Long)
#End If

Dim swApp As Object
Dim model As Object
Dim assy As Object

Sub main()
    Dim feats As Object
    Dim feat As Object
    Dim mate As Object
    Dim angleMate As Object
    Dim stepI As Long
    Dim t As Double
    Dim ang As Double
    Dim openA As Double
    Dim closedA As Double
    Dim usedMate As Boolean
    Dim drive As Object
    Dim comps As Variant
    Dim i As Long
    Dim nm As String

    On Error GoTo Boom

    Set swApp = Application.SldWorks
    Set model = swApp.ActiveDoc
    If model Is Nothing Or model.GetType <> 2 Then
        MsgBox "Open gripper ASSEMBLY first."
        Exit Sub
    End If
    Set assy = model

    openA = -155# * 3.14159265358979 / 180#
    closedA = -118# * 3.14159265358979 / 180#

    ' --- try find Angle mate ---
    Set angleMate = Nothing
    On Error Resume Next
    Set feat = model.FirstFeature
    Do While Not feat Is Nothing
        If feat.GetTypeName2 = "MateGroup" Or InStr(1, feat.GetTypeName2, "Mate", vbTextCompare) > 0 Then
            ' walk subfeatures
            Dim subF As Object
            Set subF = feat.GetFirstSubFeature
            Do While Not subF Is Nothing
                If InStr(1, subF.GetTypeName2, "Mate", vbTextCompare) > 0 Then
                    Dim mObj As Object
                    Set mObj = subF.GetSpecificFeature2
                    If Not mObj Is Nothing Then
                        ' Mate2.Type = 6 often Angle; try SetAngleAndSolve2
                        If mObj.Type = 6 Or mObj.Type = 15 Then
                            Set angleMate = mObj
                            Exit Do
                        End If
                    End If
                End If
                Set subF = subF.GetNextSubFeature
            Loop
            If Not angleMate Is Nothing Then Exit Do
        End If
        Set feat = feat.GetNextFeature
    Loop
    On Error GoTo Boom

    usedMate = False
    If Not angleMate Is Nothing Then
        MsgBox "Found Angle mate. Playing open->closed->open."
        usedMate = True
        For stepI = 0 To 40
            t = stepI / 40#
            If t <= 0.5 Then
                ang = openA + (closedA - openA) * (t / 0.5)
            Else
                ang = closedA + (openA - closedA) * ((t - 0.5) / 0.5)
            End If
            On Error Resume Next
            angleMate.SetAngleAndSolve2 ang, True
            On Error GoTo Boom
            model.GraphicsRedraw2
            DoEvents
#If VBA7 Then
            Sleep 80
#Else
            Sleep 80
#End If
        Next stepI
        MsgBox "Done (Angle mate drive)."
        Exit Sub
    End If

    ' --- fallback: rotate component named crank/drive/gear ---
    Set drive = Nothing
    comps = assy.GetComponents(False)
    If Not IsEmpty(comps) Then
        For i = 0 To UBound(comps)
            nm = ""
            On Error Resume Next
            nm = LCase$(comps(i).Name2)
            On Error GoTo Boom
            If InStr(nm, "crank") > 0 Or InStr(nm, "drive_gear") > 0 Or InStr(nm, "02_") > 0 Then
                Set drive = comps(i)
                Exit For
            End If
        Next i
        If drive Is Nothing Then
            For i = 0 To UBound(comps)
                nm = ""
                On Error Resume Next
                nm = LCase$(comps(i).Name2)
                If InStr(nm, "gear") > 0 Then
                    Set drive = comps(i)
                    Exit For
                End If
                On Error GoTo Boom
            Next i
        End If
    End If

    If drive Is Nothing Then
        MsgBox "No Angle mate and no gear component found." & vbCrLf & _
               "Add an Angle mate (Holder <-> CrankGear), then run again."
        Exit Sub
    End If

    model.ClearSelection2 True
    On Error Resume Next
    model.Extension.SelectByID2 drive.Name2, "COMPONENT", 0, 0, 0, False, 0, Nothing, 0
    assy.UnfixComponent
    On Error GoTo Boom

    MsgBox "No Angle mate. Trying Transform on: " & drive.Name2 & vbCrLf & _
           "(If mates snap it back, add Angle mate and rerun.)"

    For stepI = 0 To 40
        t = stepI / 40#
        If t <= 0.5 Then
            ang = openA + (closedA - openA) * (t / 0.5)
        Else
            ang = closedA + (openA - closedA) * ((t - 0.5) / 0.5)
        End If
        Call SetCompYaw(drive, ang)
        On Error Resume Next
        assy.EditRebuild3
        On Error GoTo Boom
        model.GraphicsRedraw2
        DoEvents
        Sleep 80
    Next stepI

    MsgBox "Done. Record screen if it moved. Else add Angle mate + Gear mate."
    Exit Sub

Boom:
    MsgBox "ERR " & Err.Number & ": " & Err.Description
End Sub

Sub SetCompYaw(comp As Object, yawRad As Double)
    Dim swMath As Object
    Dim tData(15) As Double
    Dim xf As Object
    Dim i As Long
    Dim c As Double, s As Double
    Dim ox As Double, oy As Double, oz As Double

    On Error GoTo Fail
    Set swMath = swApp.GetMathUtility
    Set xf = comp.Transform2
    For i = 0 To 15
        tData(i) = xf.ArrayData(i)
    Next i
    ox = tData(9): oy = tData(10): oz = tData(11)
    ' ArrayData layout: n1..n3, o1..o3, a1..a3, origin — SW uses 16 doubles
    ' Safer: keep translation indices from existing transform
    ox = xf.ArrayData(9)
    oy = xf.ArrayData(10)
    oz = xf.ArrayData(11)

    c = Cos(yawRad): s = Sin(yawRad)
    tData(0) = c:   tData(1) = s:  tData(2) = 0#
    tData(3) = -s:  tData(4) = c:  tData(5) = 0#
    tData(6) = 0#:  tData(7) = 0#: tData(8) = 1#
    tData(9) = ox:  tData(10) = oy: tData(11) = oz
    tData(12) = 1#: tData(13) = 0#: tData(14) = 0#: tData(15) = 0#

    Set xf = swMath.CreateTransform(tData)
    If Not xf Is Nothing Then comp.Transform2 = xf
Fail:
End Sub
