' Tries to create Motion Study Animation + rotary motor on selected CYLINDRICAL FACE.
' 1) Open assembly
' 2) Select cylindrical face of CrankGear axis (the hole/shaft face)
' 3) Run this macro
' 4) Motion Study -> Calculate -> Play
'
' If CreateMotor fails (common on AppStream), use Demo_OpenClose_Live.swb instead.

Option Explicit

Sub main()
    Dim swApp As Object
    Dim model As Object
    Dim motMgr As Object
    Dim study As Object
    Dim motor As Object
    Dim nSel As Long
    Dim i As Long
    Dim ok As Boolean

    On Error GoTo Boom

    Set swApp = Application.SldWorks
    Set model = swApp.ActiveDoc
    If model Is Nothing Or model.GetType <> 2 Then
        MsgBox "Open assembly first."
        Exit Sub
    End If

    nSel = model.SelectionManager.GetSelectedObjectCount2(-1)
    If nSel < 1 Then
        MsgBox "Select a CYLINDRICAL FACE on the drive gear axis, then run again."
        Exit Sub
    End If

    Set motMgr = Nothing
    On Error Resume Next
    Set motMgr = model.Extension.GetMotionStudyManager
    On Error GoTo Boom

    If motMgr Is Nothing Then
        MsgBox "Motion Study Manager not available in this SW license."
        Exit Sub
    End If

    Set study = Nothing
    On Error Resume Next
    Set study = motMgr.GetMotionStudy("Motion Study 1")
    If study Is Nothing Then Set study = motMgr.CreateMotionStudy
    On Error GoTo Boom

    If study Is Nothing Then
        MsgBox "Cannot create/get Motion Study."
        Exit Sub
    End If

    On Error Resume Next
    study.StudyType = 1          ' Animation
    study.Activate 0
    ' duration ~6s if property exists
    study.SetDuration 6#
    On Error GoTo Boom

    Set motor = Nothing
    ok = False
    On Error Resume Next
    ' Try a few late-bound CreateMotor signatures
    Set motor = study.CreateMotor(1, 0, 0, Nothing, Nothing, Nothing, Nothing, Nothing)
    If motor Is Nothing Then Set motor = CallByName(study, "CreateMotor", VbMethod, 1)
    If Not motor Is Nothing Then ok = True
    Err.Clear
    On Error GoTo Boom

    If Not ok Then
        MsgBox "Motion Study opened, but auto-Motor failed (API blocked)." & vbCrLf & vbCrLf & _
               "Do manually:" & vbCrLf & _
               "1) Motion Study tab" & vbCrLf & _
               "2) Motor -> Rotary Motor" & vbCrLf & _
               "3) Pick same cylindrical face" & vbCrLf & _
               "4) Oscillating / 180 deg / 6 sec" & vbCrLf & _
               "5) Calculate" & vbCrLf & vbCrLf & _
               "OR run Demo_OpenClose_Live.swb for instant motion."
        Exit Sub
    End If

    On Error Resume Next
    study.Calculate
    On Error GoTo Boom

    MsgBox "Motor created (or attempted). Open Motion Study -> Calculate -> Play."
    Exit Sub

Boom:
    MsgBox "ERR " & Err.Number & ": " & Err.Description & vbCrLf & _
           "Use Demo_OpenClose_Live.swb instead — more reliable."
End Sub
